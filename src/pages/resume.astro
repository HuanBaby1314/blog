---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection, render } from 'astro:content';

// Resume versions: all are rendered at build time; a tiny inline script
// toggles visibility on the client based on the ?v= query param.
//   ?v=ai         -> AI 应用开发版 (default)
//   ?v=fullstack  -> AI 全栈版
//   ?v=fde        -> FDE 前沿部署版
const VERSIONS = [
	{ key: 'ai', slug: '202607', label: 'AI 应用开发' },
	{ key: 'fullstack', slug: '202607-fullstack', label: 'AI 全栈' },
	{ key: 'fde', slug: '202607-fde', label: 'FDE 前沿部署' },
] as const;

const posts = await getCollection('resume');

// Render every version up front so the static page ships with all variants.
const rendered = await Promise.all(
	VERSIONS.map(async (v) => {
		const post = posts.find((p) => p.id === v.slug);
		if (!post) {
			throw new Error(`Resume version "${v.slug}" not found`);
		}
		const { Content } = await render(post);
		return { ...v, Content };
	}),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} · Resume`} description={SITE_DESCRIPTION} />
	</head>
	<style>
		main {
			width: 960px;
		}
		/* Version switcher */
		.version-bar {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 0.5rem;
			flex-wrap: wrap;
			margin: 1.5em 0 0.5em;
		}
		.version-bar .label {
			color: rgb(var(--gray));
			font-size: 0.9em;
		}
		.version-bar a {
			display: inline-block;
			padding: 0.35em 1em;
			border-radius: 999px;
			text-decoration: none;
			color: rgb(var(--gray-dark));
			background: rgb(var(--gray-light), 40%);
			font-size: 0.9em;
			transition: 0.2s ease;
		}
		.version-bar a:hover {
			color: var(--accent);
			background: rgb(var(--gray-light), 80%);
		}
		.version-bar a.active {
			color: #fff;
			background: var(--accent);
			font-weight: 600;
		}
		/* Hide inactive resume variants. `hidden` is updated client-side from ?v=. */
		.resume-variant[hidden] {
			display: none;
		}
		ul {
			display: flex;
			flex-wrap: wrap;
			gap: 2rem;
			list-style-type: none;
			margin: 0;
			padding: 0;
		}
		ul li {
			width: calc(50% - 1rem);
		}
		ul li * {
			text-decoration: none;
			transition: 0.2s ease;
		}
		ul li:first-child {
			width: 100%;
			margin-bottom: 1rem;
			text-align: center;
		}
		ul li:first-child img {
			width: 100%;
		}
		ul li:first-child .title {
			font-size: 2.369rem;
		}
		ul li img {
			margin-bottom: 0.5rem;
			border-radius: 12px;
		}
		ul li a {
			display: block;
		}
		.title {
			margin: 0;
			color: rgb(var(--black));
			line-height: 1;
		}
		.date {
			margin: 0;
			color: rgb(var(--gray));
		}
		ul li a:hover h4,
		ul li a:hover .date {
			color: rgb(var(--accent));
		}
		ul a:hover img {
			box-shadow: var(--box-shadow);
		}
		@media (max-width: 720px) {
			ul {
				gap: 0.5em;
			}
			ul li {
				width: 100%;
				text-align: center;
			}
			ul li:first-child {
				margin-bottom: 0;
			}
			ul li:first-child .title {
				font-size: 1.563em;
			}
		}
	</style>
	<body>
		<Header />
		<main>
			<nav class="version-bar" aria-label="简历版本切换">
				<span class="label">简历版本：</span>
				{
					rendered.map((r) => (
						<a
							href={`/resume?v=${r.key}`}
							data-version={r.key}
						>
							{r.label}
						</a>
					))
				}
			</nav>
			{
				rendered.map((r) => (
					<section class="resume-variant" data-version={r.key} hidden={r.key !== 'ai'}>
						<r.Content />
					</section>
				))
			}
		</main>
		<Footer />
		<script is:inline>
			(function () {
				const params = new URLSearchParams(location.search);
				const wanted = params.get('v') || 'ai';
				const variants = document.querySelectorAll('.resume-variant');
				const links = document.querySelectorAll('.version-bar a[data-version]');
				let active = wanted;
				const known = new Set(Array.from(variants).map((el) => el.dataset.version));
				if (!known.has(active)) active = 'ai';
				variants.forEach((el) => {
					el.hidden = el.dataset.version !== active;
				});
				links.forEach((a) => {
					a.classList.toggle('active', a.dataset.version === active);
				});
			})();
		</script>
	</body>
</html>
